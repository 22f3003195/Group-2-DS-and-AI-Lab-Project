# Copy to .env.local for local development (.env.local is gitignored).
#
# Point the UI at a backend you are running yourself. Without these it talks to
# the deployed proxy Space, so you would be testing the DEPLOYED code, not your
# working tree.
#
#   cd .. && MEDREPORT_STUB_MODELS=1 python app.py     # serves on :7860
#
VITE_GRADIO_ENDPOINT=http://127.0.0.1:7860
VITE_ANALYZE_API=/analyze_report

# Never put a token in this file. Vite inlines every VITE_* variable into the
# client bundle, where any visitor can read it. Tokens belong on the proxy
# Space as a secret.
